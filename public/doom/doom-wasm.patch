@@ -373,26 +373,67 @@ void D_RunFrame()
     int tics;
     static int wipestart;
     static boolean wipe;
+    // The wipe below (and I_Sleep generally) suspends this iteration through
+    // asyncify. The browser keeps scheduling main-loop iterations while one
+    // is suspended, and reentering wasm then corrupts the asyncify rewind
+    // state, which shows up later as wild memory writes. Refuse to reenter.
+    static boolean in_frame;
+
+    if (in_frame) {
+        return;
+    }
+    in_frame = true;
 
     if (wipe) {
-        do {
-            nowtime = I_GetTime();
-            tics = nowtime - wipestart;
-            I_Sleep(1);
-        } while (tics <= 0);
+        // Melt at tic rate without blocking: when no tic has passed yet, give
+        // the frame back to the browser and continue on the next iteration
+        nowtime = I_GetTime();
+        tics = nowtime - wipestart;
+        if (tics <= 0) {
+            in_frame = false;
+            return;
+        }
 
         wipestart = nowtime;
         wipe = !wipe_ScreenWipe(wipe_Melt, 0, 0, SCREENWIDTH, SCREENHEIGHT, tics);
         I_UpdateNoBlit();
         M_Drawer();       // menu is drawn even on top of wipes
         I_FinishUpdate(); // page flip or blit buffer
+        in_frame = false;
         return;
     }
 
+#ifdef __EMSCRIPTEN__
+    // The display runs faster than DOOM's 35Hz: skip frames until the next
+    // tic is due, rather than running TryRunTics into a wait
+    {
+        static int last_tic = -1;
+        nowtime = I_GetTime();
+        if (nowtime == last_tic) {
+            in_frame = false;
+            return;
+        }
+        last_tic = nowtime;
+    }
+#endif
+
     // frame syncronous IO operations
     I_StartFrame();
 
+#ifdef __EMSCRIPTEN__
+    {
+        // TryRunTics returns instead of waiting when no tic is due; with no new
+        // tic there's nothing new to draw, and before the first one nothing to draw
+        int previous_gametic = gametic;
+        TryRunTics();
+        if (gametic == previous_gametic) {
+            in_frame = false;
+            return;
+        }
+    }
+#else
     TryRunTics(); // will run at least one tic
+#endif
 
     S_UpdateSounds(players[consoleplayer].mo); // move positional sounds
 
@@ -409,6 +450,8 @@ void D_RunFrame()
             I_FinishUpdate(); // page flip or blit buffer
         }
     }
+
+    in_frame = false;
 }
 
