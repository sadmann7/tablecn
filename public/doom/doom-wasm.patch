diff --git a/opl/opl.c b/opl/opl.c
index a1aa1d9..331db03 100644
--- a/opl/opl.c
+++ b/opl/opl.c
@@ -285,6 +285,14 @@ opl_init_result_t OPL_Detect(void)
     int result1, result2;
     int i;
 
+#ifdef __EMSCRIPTEN__
+    // The SDL driver's OPL clock only advances from the audio callback, which
+    // doesn't run until a user gesture unlocks the AudioContext, so the
+    // timer-based probe below can never pass at init. The emulated chip is
+    // always present.
+    return OPL_INIT_OPL3;
+#endif
+
     // Reset both timers:
     OPL_WriteRegister(OPL_REG_TIMER_CTRL, 0x60);
 
@@ -480,6 +488,13 @@ void OPL_Delay(uint64_t us)
         return;
     }
 
+#ifdef __EMSCRIPTEN__
+    // The delay callback fires from the audio callback, which shares the main
+    // thread here: waiting would deadlock. The emulated OPL needs no hardware
+    // settle time, so don't wait.
+    return;
+#endif
+
     // Create a callback that will signal this thread after the
     // specified time.
 
diff --git a/src/doom/d_main.c b/src/doom/d_main.c
index 9a462e2..9810f6b 100644
--- a/src/doom/d_main.c
+++ b/src/doom/d_main.c
@@ -373,6 +373,16 @@ void D_RunFrame()
     int tics;
     static int wipestart;
     static boolean wipe;
+    // The wipe below (and I_Sleep generally) suspends this iteration through
+    // asyncify. The browser keeps scheduling main-loop iterations while one
+    // is suspended, and reentering wasm then corrupts the asyncify rewind
+    // state, which shows up later as wild memory writes. Refuse to reenter.
+    static boolean in_frame;
+
+    if (in_frame) {
+        return;
+    }
+    in_frame = true;
 
     if (wipe) {
         do {
@@ -386,6 +396,7 @@ void D_RunFrame()
         I_UpdateNoBlit();
         M_Drawer();       // menu is drawn even on top of wipes
         I_FinishUpdate(); // page flip or blit buffer
+        in_frame = false;
         return;
     }
 
@@ -409,6 +420,8 @@ void D_RunFrame()
             I_FinishUpdate(); // page flip or blit buffer
         }
     }
+
+    in_frame = false;
 }
 
