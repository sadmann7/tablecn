diff --git a/src/doomtype.h b/src/doomtype.h
index 9947a07..cd668b5 100644
--- a/src/doomtype.h
+++ b/src/doomtype.h
@@ -100,21 +100,14 @@
 
 #include <inttypes.h>
 
-#if defined(__cplusplus) || defined(__bool_true_false_are_defined)
-
-// Use builtin bool type with C++.
-
-typedef bool boolean;
-
-#else
-
-typedef enum 
-{
-    false, 
-    true
-} boolean;
-
-#endif
+// One boolean for every translation unit: the emscripten headers that some
+// files include pull in <stdbool.h>, and letting those files fall into a
+// 1-byte bool while the rest use the 4-byte enum gives structs like player_t
+// two incompatible layouts in one binary. It must stay 4 bytes and plain
+// integer: the renderer stores -1 in a boolean as a third state.
+#include <stdbool.h>
+
+typedef int32_t boolean;
 
 typedef uint8_t byte;
 typedef uint8_t pixel_t;
