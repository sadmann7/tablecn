{
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "source.organizeImports": "explicit"
  },
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "eslint.enable": false,
  "biome.enabled": false,
  "oxc.enable": true,
  "tailwindCSS.validate": true,
  "tailwindCSS.lint.cssConflict": "ignore",
  "tailwindCSS.experimental.configFile": {
    "src/styles/globals.css": ["src/**"]
  },
  "tailwindCSS.classFunctions": ["cn", "cva", "clsx", "twMerge"],
  "css.lint.unknownAtRules": "ignore",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/*.mp4": true,
    "**/*.mp3": true,
    "**/*.avi": true,
    "**/*.mov": true,
    "**/*.webm": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/*.mp4": true,
    "**/*.mp3": true,
    "pnpm-lock.yaml": true
  },
  "files.exclude": {
    "**/.git": false,
    "**/.turbo": true
  }
}
